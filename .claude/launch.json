{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "dev-localdb",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:local"
      ],
      "port": 5174
    },
    {
      "name": "design-system",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../NB4HS-App-React-ds",
        "run",
        "dev",
        "--",
        "--port",
        "5190"
      ],
      "port": 5190,
      "autoPort": true
    },
    {
      "name": "build-localdb",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx vite build --mode localdb --outDir dist-localdb && npx vite preview --outDir dist-localdb --port 4174 --strictPort"
      ],
      "port": 4174
    }
  ]
}
